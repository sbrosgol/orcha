# Orcha configuration example.
# Copy to orcha.yaml (or config/orcha.yaml) and edit. Any value can be
# overridden by an environment variable, e.g. ORCHA_ADMIN_PASSWORD.

server:
  # Interface to bind. Defaults to 127.0.0.1 (local only); use "0.0.0.0" to
  # accept remote connections (the Docker image does this).
  host: "127.0.0.1"
  port: 8070
  worker_threads: 4
  # Bearer token required by POST /workflow (Authorization: Bearer <token>).
  # When empty, /workflow is served only if `host` is a loopback address;
  # on any other host it is disabled (503). Prefer ORCHA_SERVER_API_TOKEN.
  api_token: ""
  # Longest a POST /workflow request may wait for its run when the client
  # sends "Prefer: wait=<seconds>" (otherwise it answers 202 immediately).
  max_wait_ms: 60000

logging:
  file: "./logs/orcha.log"
  level: INFO
  console_output: true

plugins:
  directory: "./commands"
  auto_reload: false
  scan_interval_ms: 5000
  denylist_path: "./orcha-disabled-plugins.txt"   # plugins disabled via the admin UI
  # Uploading plugins from the admin dashboard (Plugins > Upload plugin).
  # An installed plugin runs code inside this server, so uploads are off unless
  # enabled here, need admin.auth_required, and must be signed with one of these
  # Ed25519 keys (scripts/orcha-plugin-sign.sh keygen prints one).
  upload:
    enabled: false
    public_keys: []                       # ["<base64 key>", ...]; env: comma-separated
    max_bytes: 33554432                   # largest library accepted (32 MB)

# Admin dashboard (/admin) and admin API (/api/plugins).
admin:
  enabled: true
  auth_required: true
  username: "admin"
  # The admin surface is DISABLED unless a password is set (fail closed) while
  # auth_required is true. Set it here or via ORCHA_ADMIN_PASSWORD.
  password: "change-me"
  realm: "Orcha Admin"

# Workflow execution limits.
workflow:
  # Time limit (ms) for steps that do not set their own `timeout_ms`.
  # 0 = no limit. Steps can also set `timeout_ms`, and a workflow can set a
  # top-level `timeout_ms` for the whole run.
  default_timeout_ms: 0
  # Run queue: every run (API, dashboard, scheduler) waits here for a runner.
  max_concurrent_runs: 4     # runs executing at once
  max_queued_runs: 64        # runs that may wait; more are rejected (HTTP 429)
  # Per-command circuit breakers, used by workflows with "circuit_breaker": true.
  circuit_breaker:
    failure_threshold: 5       # consecutive failures that open the circuit
    success_threshold: 1       # successful probes needed to close it again
    reset_timeout_ms: 30000    # how long it stays open before a probe is allowed

# Jobs: saved workflows + run history (SQLite-backed) + cron scheduler.
jobs:
  # If this file cannot be opened the server still starts, with an in-memory
  # store (logged as an error, flagged in the dashboard and GET /api/runs).
  db_path: "./orcha-jobs.db"
  max_runs: 10000               # finished runs kept; older ones are pruned (0 = keep all)
  scheduler_enabled: true       # run due jobs (schedule_cron) on a timer
  scheduler_tick_seconds: 30    # how often the scheduler checks (< 60)
